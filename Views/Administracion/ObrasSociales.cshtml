@model List<AtencionesApp.Models.Entities.ObraSocial>
@{
    ViewData["Title"] = "Obras Sociales";
}
@section Styles {
    <link rel="stylesheet" href="~/css/administracion.css" />
}

@await Html.PartialAsync("_AdminNav")

<div class="page-header mb-4">
    <div>
        <h4 class="page-title">Obras Sociales</h4>
        <p class="page-sub">@Model.Count obras sociales activas</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Administracion/CrearObraSocial" class="btn-admin-primary">
            <i class="bi bi-plus-lg"></i> Nueva obra social
        </a>
        <a href="/Administracion/Usuarios" class="btn-admin-back">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert-admin-ok mb-3">
        <i class="bi bi-check-circle-fill"></i> @TempData["Exito"]
    </div>
}

<div class="admin-card mb-3">
    <table class="table-app">
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td style="color: var(--content-text);">@o.Nombre</td>
                    <td>
                        <div class="table-actions">
                            <a href="/Administracion/EditarObraSocial/@o.Id"
                               class="btn-icon" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post"
                                  action="/Administracion/EliminarObraSocial/@o.Id"
                                  onsubmit="return confirm('¿Eliminar obra social?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-icon btn-icon-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="admin-card text-center" style="padding: 40px; color: var(--sidebar-text);">
        No hay obras sociales registradas
    </div>
}
