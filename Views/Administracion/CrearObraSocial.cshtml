@model AtencionesApp.Models.ViewModels.ObraSocialFormViewModel
@{
    ViewData["Title"] = "Nueva Obra Social";
}
@section Styles {
    <link rel="stylesheet" href="~/css/administracion.css" />
}

<div class="page-header mb-4">
    <div>
        <h4 class="page-title">Nueva Obra Social</h4>
    </div>
    <a href="/Administracion/ObrasSociales" class="btn-admin-back">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
</div>

<div class="form-card" style="max-width: 560px;">
    <form method="post" action="/Administracion/CrearObraSocial">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label-small">NOMBRE</label>
                <input asp-for="Nombre" class="form-control form-control-app"
                       placeholder="Ej: (OSDE) OBRA SOCIAL DE EJECUTIVOS..." />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
        </div>
        <div class="form-actions-admin mt-4">
            <button type="submit" class="btn-admin-primary">
                <i class="bi bi-plus-lg"></i> Crear obra social
            </button>
            <a href="/Administracion/ObrasSociales" class="btn-cancelar-admin">Cancelar</a>
        </div>
    </form>
</div>
